# 复制成 .env 后填自己的（.env 与 accounts.txt 都已被 .gitignore 排除，不会提交）
# 多账号更推荐直接写同目录的 accounts.txt，见 README

# 多账号：竖线分隔，每段 账号::密码[::备注]，整个值写在同一行、不要换行
VOYAGE_ACCOUNTS=someone1@example.com::你的密码1::账号1|someone2@example.com::你的密码2::账号2

# 旧版单账号写法，仍然支持
# VOYAGE_ACCOUNT=你的账号或邮箱
# VOYAGE_PASSWORD=你的密码

# 可选
# VOYAGE_TZ=Asia/Shanghai          # 记录“今天”的时区基准
# VOYAGE_RETRIES=2                 # 网络类失败的重试次数（登录失败不重试）
# VOYAGE_GAP_MS=3000               # 账号之间的间隔
# VOYAGE_ONLY=账号1                # 只跑指定账号
# VOYAGE_ACTION_NAME=signInAction  # 站点改版后 action 函数名变了才需要改
# VOYAGE_COOKIE=voyage_at=...; voyage_rt=...   # 直接复用浏览器登录态，绕过账密
# VOYAGE_DATA_DIR=/data            # 运行时文件目录（容器挂卷时才需要）
